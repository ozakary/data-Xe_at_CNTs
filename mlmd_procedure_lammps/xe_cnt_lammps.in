units metal
atom_style atomic
atom_modify map yes
dimension 3
newton on
boundary p p p

# Read initial structure
read_data ../cnt_22_0_u23_Xe13.data

# Using Symmetrix package
pair_style    symmetrix/mace
pair_coeff    * * ../../../../../fine-tuned_mace-omat-0-medium-54-6.json C Xe

mass 1 12.0107  # C
mass 2 131.293  # Xe

# Set temperature (modify this value for each job)
variable TEMP equal 100.0

# Initialize velocities
velocity all create ${TEMP} 123456

# Neighbor list settings
neighbor 1.0 bin
neigh_modify delay 5 every 1

# Simulation timestep (1 fs)
timestep 0.001

#===============================================
# STAGE 1: ENERGY MINIMIZATION
#===============================================

print "Starting energy minimization..."

thermo 100
minimize 1.0e-4 1.0e-6 1000 10000

print "Energy minimization completed."


#===============================================
# STAGE 2: EQUILIBRATION (100 ps at TEMP)
#===============================================

print "Starting equilibration run (100 ps at TEMP)..."

# Initialize velocities
velocity all create ${TEMP} 1234567 loop geom

# No velocity reinitialization to maintain temperature continuity
fix equil_nvt all nvt temp ${TEMP} ${TEMP} $(100*dt)

# Output settings for equilibration
thermo 100
thermo_style custom step temp press pe ke etotal vol

dump equil_dump all custom 100 equilibration.dump id type x y z vx vy vz fx fy fz
restart 10000 equil.restart

# Run equilibration: 100 ps = 100,000 timesteps
run 100000

# Clean up equilibration phase
undump equil_dump
unfix equil_nvt

print "Equilibration completed."

#===============================================
# STAGE 3: PRODUCTION RUN (10 ns at TEMP, NVT)
#===============================================

print "Starting production run (10 ns at TEMP, 1 atm NPT)..."

# Continue with NVT ensemble at normal conditions
# Temperature: TEMP, Pressure: 1 atm (1.01325 bar in metal units)
fix prod_nvt all nvt temp ${TEMP} ${TEMP} $(100*dt)

# Output settings for production
thermo 100

thermo_style custom step temp press pe ke etotal vol density

dump prod_dump all custom 100 production.dump id type x y z

restart 10000 production.restart

# Run production: 10 ns = 10,000,000 timesteps
run 10000000

print "Production run completed."
