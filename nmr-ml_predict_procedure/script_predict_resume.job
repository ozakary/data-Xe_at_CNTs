module load cray-python/3.10.10
source /scratch/project_462001159/zakaryou/packages/matten_installation/matten_env_rocm2/bin/activate

python3 -c "import torch; print('GPU available:', torch.cuda.is_available()); print('GPU name:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'N/A')"

python3 predict_atomic_tensor.py cnt_traj_out_chunk_01.xyz output_prediction_chunk_01.csv \
  --save_every 1 \
  --resume \
  --model_path "/scratch/project_462001159/zakaryou/NMR-ML/MatTen/SWCNTs/nmr-ml_model/both_cnts_r-cut_10/matten_logs/matten_proj_xe_swcnts_10_0_and_17_0/4491y9lt/checkpoints/" \
